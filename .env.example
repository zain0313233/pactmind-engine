# Database (same Neon URL as Next.js app)
DATABASE_URL=postgresql://user:password@host/pactmind?sslmode=require

# Shared secret — must match ENGINE_API_SECRET in pactmind/.env
# In pactmind/.env avoid double quotes when the value contains $ (Next.js expands $VAR).
ENGINE_API_SECRET=change-me-shared-secret-between-nextjs-and-engine

# Max concurrent embed/LLM background jobs per worker (default 3)
ENGINE_MAX_CONCURRENT_JOBS=3

# Supabase host allowlist for document downloads (SSRF protection)
SUPABASE_URL=https://your-project.supabase.co
# Or set explicitly:
# SUPABASE_STORAGE_HOST=your-project.supabase.co

# Rate limiting (per worker process; use a gateway for multi-worker deployments)
ENGINE_RATE_LIMIT_MAX=120
ENGINE_RATE_LIMIT_WINDOW_SEC=60

# CORS — leave empty in production (engine is server-to-server only).
# Set only for local browser testing, e.g. http://localhost:3000
ENGINE_CORS_ORIGINS=

# Groq (LLM)
GROQ_API_KEY=

# Voyage AI (Embeddings) - Lightweight alternative to sentence-transformers
# Get free API key at: https://www.voyageai.com/
# Leave empty for local dev (uses fallback hash-based embeddings)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Pinecone (Vector Database)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=pactmind
